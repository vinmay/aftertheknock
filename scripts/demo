#!/usr/bin/env bash
# Deterministic walkthrough for recording the demo GIF / video.
#   scripts/demo          serve the committed recording (no model; identical every take)
#   scripts/demo --live   play live with a fixed seed in the terminal (needs Ollama)
#
# Recording the GIF (about 30-40 s), using the recommended recording "The photo of my sister, then the key"
# (recorded with Gemma 4 31B, hosted):
#   1. Open the URL printed below. It starts the recorded night directly.
#   2. Opening: pause on "Please. You already let me in." Choose "Recorded choice: Lock it".
#   3. Click through to the first crossing. Let the photo card finish writing its four digits. Click "Go on".
#   4. Click the digits in the story: the flashback of the other night opens. Hold 3 s. Close it.
#   5. Continue through the second crossing to the door. Hold on "Why do you get to be the real one?"
#   6. Choose the recorded ending. Click "Explore the nights you didn't live": let the reveal play; the
#      first crossing lights up with its thread. Close the map. Click "See how this haunting was generated
#      and verified", scroll to the end, click
#      "Re-run this night through the engine". Hold on "Reproduced exactly."
# Tips: 1280x800 window, browser zoom 100%, sound on if recording video, hide bookmarks and other tabs.
set -euo pipefail
cd "$(dirname "$0")/.."
PORT="${PORT:-8047}"
REPLAY="${REPLAY:-lock_roof_erase_1001}"
if [[ "${1:-}" == "--live" ]]; then
  echo "Live, fixed seed 4711. Pocket: folded receipt. Choices: lock, roof, erase."
  uv run knock auto lock roof erase --seed 4711 --pocket "a folded receipt"
  exit 0
fi
sed -n '5,14p' "$0" | sed 's/^# \{0,1\}//'
echo
echo "Open http://localhost:$PORT/?replay=$REPLAY"
uv run knock-server --port "$PORT" --replay-only
