# Copy to .env (gitignored). Local Ollama is the default; nothing here is needed for it.
# KNOCK_PROVIDER=ollama
# KNOCK_MODEL=gemma4:e2b

# Hosted live mode: an open-weight Gemma behind an OpenAI-compatible API.
# DigitalOcean serverless inference serves Gemma 4 31B as gemma-4-31B-it.
# KNOCK_PROVIDER=openai
# KNOCK_OPENAI_BASE_URL=https://inference.do-ai.run/v1
# KNOCK_OPENAI_MODEL=gemma-4-31B-it
# KNOCK_OPENAI_API_KEY=            # owner provides; never commit (DIGITALOCEAN_INFERENCE_KEY also accepted)
# KNOCK_PRICE_IN_PER_M=0.18        # USD per 1M input tokens (DO pricing page, 2026-10-27)
# KNOCK_PRICE_OUT_PER_M=0.50       # USD per 1M output tokens
# KNOCK_SPEND_CAP_USD=10           # hard stop for all hosted calls
# KNOCK_SPEND_FILE=eval/results/spend.json
